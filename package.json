{
  "name": "essay-writing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/seed.ts",
    "admin:create": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/create-admin.ts",
    "vercel-build": "npm run db:migrate && next build"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "mammoth": "1.13.0",
    "next": "^16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "turndown": "7.2.4",
    "unified": "11.0.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "22.18.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/turndown": "5.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "^16.4.3",
    "jszip": "3.10.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20.9.0 <23"
  }
}
