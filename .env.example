# PostgreSQL 연결 문자열 (docker compose 기본값 기준)
DATABASE_URL=postgres://essay:essay_local_password@localhost:54329/essay
# 통합 테스트 / E2E 테스트 전용 DB
DATABASE_URL_TEST=postgres://essay:essay_local_password@localhost:54329/essay_test

# Better Auth: 32자 이상의 임의 문자열. 생성 예: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# 서비스가 실제로 접속되는 URL
BETTER_AUTH_URL=http://localhost:3000

# 초기 관리자 계정 (npm run admin:create 에서 사용, 실행 후 비워 두어도 됨)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=관리자
